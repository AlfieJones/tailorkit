{
  "name": "@tailorkit/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "drizzle-kit": "node --preserve-symlinks-main ./node_modules/drizzle-kit/bin.cjs",
    "db:push": "pnpm drizzle-kit push",
    "db:generate": "pnpm drizzle-kit generate",
    "db:studio": "pnpm drizzle-kit studio",
    "db:migrate": "pnpm drizzle-kit migrate"
  },
  "dependencies": {
    "@tailorkit/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "^8.17.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/pg": "catalog:",
    "drizzle-kit": "^1.0.0-rc.2",
    "typescript": "catalog:"
  }
}
