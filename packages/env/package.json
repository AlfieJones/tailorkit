{
  "name": "@tailorkit/env",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": {
      "development": "./src/server.ts",
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./web": {
      "development": "./src/web.ts",
      "types": "./dist/web.d.mts",
      "default": "./dist/web.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/server.ts src/web.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.1",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
