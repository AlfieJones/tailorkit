{
  "name": "@tailorkit/email",
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "dev": "email dev --dir src/templates --port 3003"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1053.0",
    "@react-email/components": "^1.0.1",
    "@react-email/render": "^2.0.8",
    "@tailorkit/env": "workspace:*",
    "nodemailer": "^8.0.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-email": "6.3.2"
  },
  "devDependencies": {
    "@react-email/ui": "6.3.2",
    "@tailorkit/config": "workspace:*",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
