{
  "name": "@tailorkit/api-platform",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./openapi": {
      "default": "./openapi.json"
    },
    "./context": {
      "development": "./src/context.ts",
      "types": "./dist/context.d.mts",
      "default": "./dist/context.mjs"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/context.ts src/pagination.ts src/procedures.ts src/routes/apps.ts src/routes/cli-auth.ts src/routes/deployments.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "generate:openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@tailorkit/api-utils": "workspace:*",
    "@tailorkit/auth": "workspace:*",
    "@tailorkit/db": "workspace:*",
    "@tailorkit/env": "workspace:*",
    "@tailorkit/storage": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
