{
  "name": "@tailorkit/auth",
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/lib/email.ts src/lib/permissions.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "generate": "better-auth generate --config src/index.ts --output ../db/src/schema/auth.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.11",
    "@better-auth/infra": "^0.2.8",
    "@tailorkit/db": "workspace:*",
    "@tailorkit/email": "workspace:*",
    "@tailorkit/env": "workspace:*",
    "@tailorkit/kv": "workspace:*",
    "@tailorkit/observability": "workspace:*",
    "@vercel/functions": "^3.6.0",
    "better-auth": "catalog:",
    "uuid": "^14.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/cli": "latest",
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
