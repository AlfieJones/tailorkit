{
  "name": "@tailorkit/api-utils",
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    "./rate-limiting": {
      "development": "./src/rate-limiting.ts",
      "types": "./dist/rate-limiting.d.mts",
      "default": "./dist/rate-limiting.mjs"
    },
    "./hashing": {
      "development": "./src/hashing.ts",
      "types": "./dist/hashing.d.mts",
      "default": "./dist/hashing.mjs"
    },
    "./dev-delay": {
      "development": "./src/dev-delay.ts",
      "types": "./dist/dev-delay.d.mts",
      "default": "./dist/dev-delay.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/rate-limiting.ts src/hashing.ts src/dev-delay.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@orpc/experimental-ratelimit": "^1.14.3",
    "@orpc/server": "catalog:",
    "@tailorkit/env": "workspace:*",
    "@tailorkit/kv": "workspace:*",
    "@tailorkit/observability": "workspace:*",
    "@upstash/ratelimit": "^2.0.8",
    "@vercel/functions": "^3.6.0"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
