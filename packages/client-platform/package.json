{
  "name": "@tailorkit/client-platform",
  "version": "0.1.0-beta.10",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlfieJones/tailorkit.git",
    "directory": "packages/client-platform"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client/*": {
      "types": "./dist/client/*.d.ts",
      "import": "./dist/client/*.js"
    },
    "./preview-tunnel": {
      "types": "./dist/preview-tunnel.d.ts",
      "import": "./dist/preview-tunnel.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup 'src/**/*.ts' --format esm --target node20 --clean && tsc -p tsconfig.build.json",
    "generate": "openapi-ts && node ./scripts/restore-openapi-params.mjs && oxfmt src/client",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@orpc/client": "catalog:"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "next",
    "@tailorkit/api-platform": "workspace:*",
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
