{
  "name": "@tailorkit/client-platform",
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./client": {
      "default": "./src/client/index.ts"
    },
    "./client/*": {
      "default": "./src/client/*.ts"
    }
  },
  "scripts": {
    "generate": "openapi-ts",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.2",
    "@tailorkit/api-platform": "workspace:*",
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
