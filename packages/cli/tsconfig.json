{
  "extends": "@tailorkit/config/tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "strictNullChecks": true,
    "types": ["bun", "node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
