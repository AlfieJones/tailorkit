{
  "name": "@tailorkit/kv",
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/kv.ts src/redis.ts src/upstash.ts src/types.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@tailorkit/env": "workspace:*"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "@upstash/redis": "^1.38.0",
    "ioredis": "^5.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@upstash/redis": "^1.34.0",
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@upstash/redis": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  }
}
