{
  "name": "@tailorkit/sandbox",
  "version": "0.1.0-beta.3",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlfieJones/tailorkit.git",
    "directory": "packages/sandbox"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./worker": {
      "types": "./dist/worker/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./worker-dom": {
      "types": "./dist/worker-dom/index.d.ts",
      "import": "./dist/worker-dom/index.js"
    },
    "./worker-dom/dom": {
      "types": "./dist/worker-dom/dom.d.ts",
      "import": "./dist/worker-dom/dom.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "happy-dom": "^20.11.6",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
