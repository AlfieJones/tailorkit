{
  "name": "@tailorkit/asset-delivery",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./logo-validation": {
      "development": "./src/logo-validation.ts",
      "types": "./dist/logo-validation.d.mts",
      "default": "./dist/logo-validation.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/logo-validation.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
