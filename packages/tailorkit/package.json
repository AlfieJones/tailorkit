{
  "name": "tailorkit",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "tailorkit": "./dist/cli.js"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./zod": "./src/zod.ts",
    "./valibot": "./src/valibot.ts",
    "./arktype": "./src/arktype.ts"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts ./src/index.ts ./src/react.ts ./src/zod.ts ./src/valibot.ts ./src/arktype.ts --outdir ./dist --target node --minify",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@tailorkit/cli": "workspace:*",
    "@tailorkit/core": "workspace:*",
    "@tailorkit/react": "workspace:*"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "arktype": ">=2.1.0",
    "valibot": ">=1.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "arktype": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
