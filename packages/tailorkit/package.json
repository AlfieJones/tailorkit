{
  "name": "tailorkit",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "tailorkit": "./node_modules/@tailorkit/cli/dist/index.js"
  },
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./react": "./src/react.ts",
    "./zod": "./src/zod.ts",
    "./valibot": "./src/valibot.ts",
    "./arktype": "./src/arktype.ts"
  },
  "scripts": {
    "build": "tsup ./src/cli.ts ./src/index.ts ./src/server.ts ./src/react.ts ./src/zod.ts ./src/valibot.ts ./src/arktype.ts --out-dir ./dist --format esm --target node20 --minify --clean",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@tailorkit/cli": "workspace:*",
    "@tailorkit/core": "workspace:*",
    "@tailorkit/react": "workspace:*"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "arktype": ">=2.1.0",
    "valibot": ">=1.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "arktype": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
