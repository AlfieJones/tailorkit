{
  "name": "tailorkit",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "tailorkit": "./dist/cli.js"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts ./src/index.ts ./src/react.ts --outdir ./dist --target node --minify",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@tailorkit/cli": "workspace:*",
    "@tailorkit/core": "workspace:*",
    "@tailorkit/react": "workspace:*"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
