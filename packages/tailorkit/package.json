{
  "name": "tailorkit",
  "version": "0.1.0-beta.3",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlfieJones/tailorkit.git",
    "directory": "packages/tailorkit"
  },
  "bin": {
    "tailorkit": "./bin/tailorkit.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "tailorkit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "tailorkit-source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./react": {
      "tailorkit-source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./app": {
      "tailorkit-source": "./src/app.ts",
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./app/config": {
      "tailorkit-source": "./src/app-config.ts",
      "types": "./dist/app-config.d.ts",
      "import": "./dist/app-config.js"
    },
    "./zod": {
      "tailorkit-source": "./src/zod.ts",
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    },
    "./valibot": {
      "tailorkit-source": "./src/valibot.ts",
      "types": "./dist/valibot.d.ts",
      "import": "./dist/valibot.js"
    },
    "./arktype": {
      "tailorkit-source": "./src/arktype.ts",
      "types": "./dist/arktype.d.ts",
      "import": "./dist/arktype.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup ./src/index.ts ./src/server.ts ./src/react.ts ./src/app.ts ./src/app-config.ts ./src/zod.ts ./src/valibot.ts ./src/arktype.ts --out-dir ./dist --format esm --target node20 --minify --clean && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@tailorkit/app": "workspace:*",
    "@tailorkit/cli": "workspace:*",
    "@tailorkit/core": "workspace:*",
    "@tailorkit/react": "workspace:*"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "arktype": ">=2.1.0",
    "valibot": ">=1.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "arktype": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
