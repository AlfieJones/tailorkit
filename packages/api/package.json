{
  "name": "@tailorkit/api",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/context.ts src/procedures.ts src/routers/index.ts src/routers/org.ts src/routers/project.ts src/routers/user.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/experimental-ratelimit": "^1.14.2",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@tailorkit/api-utils": "workspace:*",
    "@tailorkit/auth": "workspace:*",
    "@tailorkit/db": "workspace:*",
    "@tailorkit/env": "workspace:*",
    "@tailorkit/kv": "workspace:*",
    "@types/pg": "catalog:",
    "@upstash/ratelimit": "^2.0.0",
    "@vercel/functions": "^3.6.0",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "nanoid": "^5.1.11",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@tailorkit/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
