{
  "name": "email",
  "private": true,
  "description": "A TailorKit.dev app that embeds in a host app to extend what it can do.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#tailorkit": "./src/tailorkit.gen.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "build": "tailorkit build",
    "generate": "tailorkit generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "check": "pnpm run lint && pnpm run format",
    "fix": "pnpm run lint:fix && pnpm run format:fix"
  },
  "dependencies": {
    "@tailorkit/app": "workspace:*",
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "oxfmt": "0.52.0",
    "oxlint": "1.67.0",
    "tailorkit": "workspace:*",
    "typescript": "^6.0.3"
  }
}
