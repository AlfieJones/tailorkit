{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "vitest run",
    "dev:web": "turbo -F web dev",
    "auth:generate": "turbo -F @tailorkit/auth generate",
    "db:push": "turbo -F @tailorkit/db db:push",
    "db:studio": "turbo -F @tailorkit/db db:studio",
    "db:generate": "turbo -F @tailorkit/db db:generate",
    "db:migrate": "turbo -F @tailorkit/db db:migrate",
    "services:start": "docker compose up -d",
    "services:watch": "docker compose up",
    "services:stop": "docker compose stop",
    "services:down": "docker compose down",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "tailorkit": "pnpm --filter @tailorkit/cli build && node ./packages/cli/dist/index.js"
  },
  "dependencies": {
    "@tailorkit/env": "workspace:*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailorkit/cli": "workspace:*",
    "@tailorkit/config": "workspace:*",
    "@types/node": "^24.12.2",
    "docs": "workspace:*",
    "lefthook": "latest",
    "oxfmt": "0.49.0",
    "oxlint": "1.64.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.9.10",
    "typescript": "^6.0.3",
    "ultracite": "7.7.0",
    "vite-imagetools": "^10.0.0",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.20.0"
}
