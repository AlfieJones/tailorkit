{
  "name": "tailorkit-new",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/node": "^22.13.14",
      "next-themes": "^0.4.6",
      "@orpc/server": "^1.13.14",
      "@orpc/client": "^1.13.14",
      "@orpc/openapi": "^1.13.14",
      "@orpc/zod": "^1.13.14",
      "better-auth": "1.5.5",
      "@polar-sh/better-auth": "^1.8.3",
      "@types/react-dom": "^19.2.3",
      "drizzle-orm": "^0.45.1",
      "@types/pg": "^8.16.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @tailorkit-new/db db:push",
    "db:studio": "turbo -F @tailorkit-new/db db:studio",
    "db:generate": "turbo -F @tailorkit-new/db db:generate",
    "db:migrate": "turbo -F @tailorkit-new/db db:migrate",
    "db:start": "turbo -F @tailorkit-new/db db:start",
    "db:watch": "turbo -F @tailorkit-new/db db:watch",
    "db:stop": "turbo -F @tailorkit-new/db db:stop",
    "db:down": "turbo -F @tailorkit-new/db db:down",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@tailorkit-new/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailorkit-new/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.8.12",
    "typescript": "catalog:",
    "ultracite": "7.6.1"
  },
  "packageManager": "bun@1.3.12"
}
