{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "dev:docs": "turbo run dev --filter=docs",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:studio": "turbo run db:studio --filter=@tailorkit/db",
    "db:generate": "turbo run db:generate --filter=@tailorkit/db",
    "db:migrate": "turbo run db:migrate --filter=@tailorkit/db",
    "services:start": "docker compose up -d",
    "services:watch": "docker compose up",
    "services:stop": "docker compose stop",
    "services:down": "docker compose down",
    "check": "turbo run quality",
    "fix": "turbo run quality:fix",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "tailorkit": "pnpm --filter @tailorkit/cli build && node ./packages/cli/dist/index.js"
  },
  "devDependencies": {
    "lefthook": "2.1.8",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "turbo": "2.9.14",
    "ultracite": "7.7.0"
  },
  "packageManager": "pnpm@11.3.0"
}
