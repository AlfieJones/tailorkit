{
  "name": "tailorkit",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "examples/*",
      "packages/*"
    ],
    "catalog": {
      "@ai-sdk/react": "^3.0.170",
      "@orpc/client": "^1.13.14",
      "@orpc/openapi": "^1.13.14",
      "@orpc/server": "^1.13.14",
      "@orpc/zod": "^1.13.14",
      "@polar-sh/better-auth": "^1.8.3",
      "@tailwindcss/vite": "^4.2.4",
      "@tanstack/react-router": "1.168.23",
      "@tanstack/react-router-devtools": "1.166.13",
      "@tanstack/react-start": "1.167.42",
      "@types/node": "^24.12.2",
      "@types/pg": "^8.16.0",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^6.0.1",
      "ai": "^6.0.168",
      "better-auth": "1.5.5",
      "class-variance-authority": "^0.7.1",
      "dotenv": "^17.2.2",
      "drizzle-orm": "^1.0.0-beta.22",
      "lucide-react": "^1.9.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "tailwind-merge": "^3.5.0",
      "tailwindcss": "^4.2.4",
      "typescript": "^6",
      "vite": "^8.0.10",
      "zod": "^4.1.13"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "auth:generate": "turbo -F @tailorkit/auth generate",
    "db:push": "turbo -F @tailorkit/db db:push",
    "db:studio": "turbo -F @tailorkit/db db:studio",
    "db:generate": "turbo -F @tailorkit/db db:generate",
    "db:migrate": "turbo -F @tailorkit/db db:migrate",
    "services:start": "docker compose up -d",
    "services:watch": "docker compose up",
    "services:stop": "docker compose stop",
    "services:down": "docker compose down",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@tailorkit/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.8.12",
    "typescript": "catalog:",
    "ultracite": "7.6.1"
  },
  "packageManager": "bun@1.3.12"
}
