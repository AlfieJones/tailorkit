{
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "infra:install": "turbo run infra:install --filter=@tailorkit/infra",
    "infra:diff": "turbo run infra:diff --filter=@tailorkit/infra",
    "infra:deploy": "turbo run infra:deploy --filter=@tailorkit/infra",
    "dev": "turbo run dev --filter=web",
    "dev:docs": "turbo run dev --filter=docs",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:studio": "turbo run db:studio --filter=@tailorkit/db",
    "db:generate": "turbo run db:generate --filter=@tailorkit/db",
    "db:migrate": "turbo run db:migrate --filter=@tailorkit/db",
    "services:start": "docker compose up -d",
    "services:watch": "docker compose up",
    "services:stop": "docker compose stop",
    "services:down": "docker compose down",
    "check": "turbo run quality",
    "fix": "turbo run quality:fix",
    "sherif": "sherif -r packages-without-package-json",
    "sherif:fix": "sherif -r packages-without-package-json --fix --select highest --no-install",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "changeset": "vp exec changeset",
    "release:status": "vp exec changeset status --verbose",
    "release:version": "vp exec changeset version",
    "release:build": "vp -C packages/client-platform run build && vp -C packages/core run build && vp -C packages/app run build && vp -C packages/sandbox run build && vp -C packages/react run build && vp -C packages/cli build && vp -C packages/tailorkit run build",
    "release:normalize": "node ./scripts/check-prerelease.mjs && node ./scripts/normalize-prerelease.mjs",
    "release:publish": "vp run release:build && node ./scripts/check-prerelease.mjs && node ./scripts/publish-prerelease.mjs",
    "tailorkit": "vp -C packages/cli build && node ./packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "sherif": "^1.13.0",
    "turbo": "2.10.11",
    "ultracite": "7.10.6",
    "vite-plus": "0.2.9"
  },
  "packageManager": "pnpm@11.23.0"
}
