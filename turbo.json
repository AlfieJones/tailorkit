{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "AUTH_SECRET",
    "BETTER_AUTH_API_KEY",
    "DATABASE_URL",
    "NODE_ENV",
    "EMAIL_SMTP_URL",
    "EMAIL_SECRET_ACCESS_KEY",
    "EMAIL_REGION",
    "EMAIL_ACCESS_KEY_ID",
    "EMAIL_PROVIDER",
    "EMAIL_FROM",
    "EMAIL_FROM_AUTH",
    "EMAIL_FROM_INVITE",
    "EMAIL_REPLY_TO",
    "KV_PROVIDER",
    "KV_REST_API_TOKEN",
    "KV_REST_API_URL",
    "KV_REDIS_URL",
    "KV_REST_API_READ_ONLY_TOKEN",
    "KV_URL",
    "BLOB_REGION",
    "BLOB_BUCKET",
    "BLOB_ENDPOINT",
    "BLOB_FORCE_PATH_STYLE",
    "BLOB_SECRET_ACCESS_KEY",
    "BLOB_ACCESS_KEY_ID",
    "BLOB_PUBLIC_BASE_URL",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_HEADERS",
    "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
    "OTEL_SDK_DISABLED",
    "OTEL_SERVICE_NAME",
    "OTEL_TRACES_SAMPLER_ARG",
    "TAILORKIT_OTEL_SAMPLE_RATE",
    "TAILORKIT_OTEL_DISABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**", ".tailorkit/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "web#dev": {
      "cache": false,
      "persistent": true,
      "with": ["//#services:watch"]
    },
    "generate": {
      "cache": false
    },
    "//#quality": {
      "dependsOn": ["//#lint", "//#format"]
    },
    "//#quality:fix": {
      "dependsOn": ["//#lint:fix", "//#format:fix"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "dependsOn": ["//#lint:fix"],
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "//#services:start": {
      "cache": false
    },
    "//#services:stop": {
      "cache": false
    },
    "//#services:watch": {
      "cache": false,
      "persistent": true
    },
    "//#services:down": {
      "cache": false
    }
  }
}
