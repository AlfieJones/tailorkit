{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "AUTH_SECRET",
    "BETTER_AUTH_API_KEY",
    "DATABASE_URL",
    "NODE_ENV",
    "EMAIL_SMTP_URL",
    "EMAIL_SECRET_ACCESS_KEY",
    "EMAIL_REGION",
    "EMAIL_ACCESS_KEY_ID",
    "EMAIL_PROVIDER",
    "EMAIL_FROM",
    "EMAIL_FROM_AUTH",
    "EMAIL_FROM_INVITE",
    "EMAIL_REPLY_TO",
    "KV_PROVIDER",
    "KV_REST_API_TOKEN",
    "KV_REST_API_URL",
    "KV_REDIS_URL",
    "BLOB_REGION",
    "BLOB_BUCKET",
    "BLOB_ENDPOINT",
    "BLOB_FORCE_PATH_STYLE",
    "BLOB_SECRET_ACCESS_KEY",
    "BLOB_ACCESS_KEY_ID",
    "BLOB_PUBLIC_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "//#services:start": {
      "cache": false
    },
    "//#services:stop": {
      "cache": false
    },
    "//#services:watch": {
      "cache": false,
      "persistent": true
    },
    "//#services:down": {
      "cache": false
    }
  }
}
