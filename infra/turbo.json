{
  "extends": ["//"],
  "tasks": {
    "check-types": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/sst.config.ts"]
    },
    "infra:install": { "cache": false },
    "infra:diff": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_*", "ASSET_*", "PLATFORM_ORIGIN", "SST_*", "CI"]
    },
    "infra:deploy": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_*", "ASSET_*", "PLATFORM_ORIGIN", "SST_*", "CI"]
    }
  }
}
